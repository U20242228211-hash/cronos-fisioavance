# Copie este archivo como .env y ajuste los valores.
DJANGO_SECRET_KEY=cambie-esta-clave
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Base de datos. Lo más fácil para probar: SQLite (un archivo, no hay que instalar nada).
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL (servidor propio):  DATABASE_URL=postgres://usuario:clave@localhost/cronos
# MySQL (hosting con cPanel):    DATABASE_URL=mysql://usuario:clave@localhost/cronos
# Correo saliente (en desarrollo los correos se muestran en la consola)
EMAIL_URL=
DEFAULT_FROM_EMAIL=Cronos <no-responder@localhost>
# Institución que se abre en la raíz "/" cuando no se usa un dominio propio
CRONOS_INSTITUCION_POR_DEFECTO=fisioavance
