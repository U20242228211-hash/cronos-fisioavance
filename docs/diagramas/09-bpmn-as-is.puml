@startuml
!include _estilo.iuml
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam titleFontSize 17
skinparam titleFontStyle bold
skinparam titleFontColor #16306B
skinparam ArrowColor #16306B
skinparam ArrowFontColor #16306B
skinparam ArrowFontSize 13
skinparam activityBackgroundColor #EAF1FB
skinparam activityBorderColor #16306B
skinparam activityFontColor #1A1A1A
skinparam activityDiamondBackgroundColor #EAF1FB
skinparam activityDiamondBorderColor #16306B
skinparam activityDiamondFontColor #16306B
skinparam activityStartColor #16306B
skinparam activityEndColor #16306B
skinparam activityBarColor #16306B
skinparam swimlaneBorderColor #16306B
skinparam swimlaneTitleFontColor #16306B
skinparam swimlaneTitleFontSize 14
skinparam swimlaneTitleFontStyle bold
skinparam NoteBackgroundColor #F3FAF4
skinparam NoteBorderColor #3DAE4B

title Proceso actual (AS-IS) — notación de carriles estilo BPMN

|Paciente|
start
if (¿Cómo deja su\nsugerencia?) then (código QR)
  :Escanea el QR
  y deja su
  sugerencia
  o queja;
  note left
    <b>Punto crítico:</b>
    baja participación:
    pereza de
    escanear el QR
    (muchos no lo
    hacen porque
    llegan de afán).
    ----
    Las encuestas
    de satisfacción
    (unas 30 al mes)
    también van
    por QR.
  end note
else (buzón)
  :Deposita su
  sugerencia
  escrita en
  el buzón de
  recepción;
  |Recepción|
  :Se abre el buzón
  (cada 2 días);
  note right
    <b>Punto crítico:</b>
    hasta 2 días
    antes de leer
    una PQRSF: un
    reclamo de
    riesgo vital
    (24 h) podría
    vencer sin
    haber sido
    leído.
  end note
endif
|Representante legal\n/ coordinación|
:Se leen las
sugerencias;
note right
  Respuesta y
  seguimiento:
  no indagados
  en la
  entrevista.
end note
stop
@enduml
