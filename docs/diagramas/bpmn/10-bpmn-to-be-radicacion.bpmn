<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definiciones_Radicacion" targetNamespace="https://github.com/U20242228211-hash/cronos-fisioavance" exporter="Cronos (generado)" exporterVersion="1.0">
  <bpmn:collaboration id="Colaboracion_Radicacion">
    <bpmn:participant id="Pac" name="Paciente o acudiente" />
    <bpmn:participant id="Ips" name="Fisioavance IPS" processRef="Proceso_Radicacion" />
    <bpmn:messageFlow id="Mensaje_1" name="PQRSF por el QR, el enlace de WhatsApp o la tableta" sourceRef="Pac" targetRef="Ini_Portal" />
    <bpmn:messageFlow id="Mensaje_2" name="Papel en el buzón" sourceRef="Pac" targetRef="T_Registrar" />
    <bpmn:messageFlow id="Mensaje_3" name="Constancia con radicado y fecha límite" sourceRef="T_Radicar" targetRef="Pac" />
    <bpmn:textAnnotation id="Nota_1"><bpmn:text>Si es de riesgo vital, el correo también le llega a la dirección.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asociacion_1" associationDirection="None" sourceRef="T_Avisar" targetRef="Nota_1" />
    <bpmn:textAnnotation id="Nota_2"><bpmn:text>El término corre desde la radicación: 8, 24, 48 o 72 horas corridas, o días hábiles con festivos.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asociacion_2" associationDirection="None" sourceRef="T_Radicar" targetRef="Nota_2" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_Radicacion" isExecutable="false">
    <bpmn:laneSet id="Carriles_Proceso_Radicacion">
      <bpmn:lane id="L_Rec" name="Recepción">
        <bpmn:flowNodeRef>Ini_Buzon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Registrar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Cro" name="Cronos (sistema)">
        <bpmn:flowNodeRef>Ini_Portal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Une</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Radicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Avisar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Ate" name="Atención al usuario">
        <bpmn:flowNodeRef>T_Confirmar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin_Rad</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Ini_Buzon" name="Todos los días">
      <bpmn:outgoing>Flujo_1</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:startEvent>
    <bpmn:userTask id="T_Registrar" name="Abrir el buzón y registrar cada PQRSF en el panel">
      <bpmn:incoming>Flujo_1</bpmn:incoming>
      <bpmn:outgoing>Flujo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="Ini_Portal" name="PQRSF radicada en el portal">
      <bpmn:outgoing>Flujo_3</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gw_Une">
      <bpmn:incoming>Flujo_2</bpmn:incoming>
      <bpmn:incoming>Flujo_3</bpmn:incoming>
      <bpmn:outgoing>Flujo_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Radicar" name="Radicar, proponer la clasificación y calcular el término">
      <bpmn:incoming>Flujo_4</bpmn:incoming>
      <bpmn:outgoing>Flujo_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="T_Avisar" name="Avisar por correo a atención al usuario">
      <bpmn:incoming>Flujo_5</bpmn:incoming>
      <bpmn:outgoing>Flujo_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="T_Confirmar" name="Confirmar la clasificación y asignar el responsable">
      <bpmn:incoming>Flujo_6</bpmn:incoming>
      <bpmn:outgoing>Flujo_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Fin_Rad" name="PQRSF en trámite">
      <bpmn:incoming>Flujo_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_1" sourceRef="Ini_Buzon" targetRef="T_Registrar" />
    <bpmn:sequenceFlow id="Flujo_2" sourceRef="T_Registrar" targetRef="Gw_Une" />
    <bpmn:sequenceFlow id="Flujo_3" sourceRef="Ini_Portal" targetRef="Gw_Une" />
    <bpmn:sequenceFlow id="Flujo_4" sourceRef="Gw_Une" targetRef="T_Radicar" />
    <bpmn:sequenceFlow id="Flujo_5" sourceRef="T_Radicar" targetRef="T_Avisar" />
    <bpmn:sequenceFlow id="Flujo_6" sourceRef="T_Avisar" targetRef="T_Confirmar" />
    <bpmn:sequenceFlow id="Flujo_7" sourceRef="T_Confirmar" targetRef="Fin_Rad" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama_Radicacion">
    <bpmndi:BPMNPlane id="Plano_Radicacion" bpmnElement="Colaboracion_Radicacion">
      <bpmndi:BPMNShape id="Pac_di" bpmnElement="Pac" isHorizontal="true"><dc:Bounds x="0" y="0" width="1055" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ips_di" bpmnElement="Ips" isHorizontal="true"><dc:Bounds x="0" y="140" width="1055" height="470" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Rec_di" bpmnElement="L_Rec" isHorizontal="true"><dc:Bounds x="30" y="140" width="1025" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Cro_di" bpmnElement="L_Cro" isHorizontal="true"><dc:Bounds x="30" y="280" width="1025" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Ate_di" bpmnElement="L_Ate" isHorizontal="true"><dc:Bounds x="30" y="450" width="1025" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ini_Buzon_di" bpmnElement="Ini_Buzon"><dc:Bounds x="292" y="192" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="270" y="158" width="80" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Registrar_di" bpmnElement="T_Registrar"><dc:Bounds x="405" y="165" width="130" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ini_Portal_di" bpmnElement="Ini_Portal"><dc:Bounds x="132" y="347" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="105" y="388" width="90" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Une_di" bpmnElement="Gw_Une" isMarkerVisible="true"><dc:Bounds x="445" y="340" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Radicar_di" bpmnElement="T_Radicar"><dc:Bounds x="565" y="320" width="130" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Avisar_di" bpmnElement="T_Avisar"><dc:Bounds x="725" y="320" width="130" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Confirmar_di" bpmnElement="T_Confirmar"><dc:Bounds x="725" y="485" width="130" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Fin_Rad_di" bpmnElement="Fin_Rad"><dc:Bounds x="932" y="512" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="910" y="553" width="80" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Nota_1_di" bpmnElement="Nota_1"><dc:Bounds x="735" y="158" width="260" height="46" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Nota_2_di" bpmnElement="Nota_2"><dc:Bounds x="200" y="480" width="320" height="52" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flujo_1_di" bpmnElement="Flujo_1"><di:waypoint x="328" y="210" /><di:waypoint x="405" y="210" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_2_di" bpmnElement="Flujo_2"><di:waypoint x="470" y="255" /><di:waypoint x="470" y="340" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_3_di" bpmnElement="Flujo_3"><di:waypoint x="168" y="365" /><di:waypoint x="445" y="365" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_4_di" bpmnElement="Flujo_4"><di:waypoint x="495" y="365" /><di:waypoint x="565" y="365" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_5_di" bpmnElement="Flujo_5"><di:waypoint x="695" y="365" /><di:waypoint x="725" y="365" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_6_di" bpmnElement="Flujo_6"><di:waypoint x="790" y="410" /><di:waypoint x="790" y="485" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_7_di" bpmnElement="Flujo_7"><di:waypoint x="855" y="530" /><di:waypoint x="932" y="530" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Mensaje_1_di" bpmnElement="Mensaje_1"><di:waypoint x="150" y="60" /><di:waypoint x="150" y="347" /><bpmndi:BPMNLabel><dc:Bounds x="158" y="70" width="150" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Mensaje_2_di" bpmnElement="Mensaje_2"><di:waypoint x="470" y="60" /><di:waypoint x="470" y="165" /><bpmndi:BPMNLabel><dc:Bounds x="478" y="70" width="90" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Mensaje_3_di" bpmnElement="Mensaje_3"><di:waypoint x="630" y="320" /><di:waypoint x="630" y="60" /><bpmndi:BPMNLabel><dc:Bounds x="638" y="70" width="140" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Asociacion_1_di" bpmnElement="Asociacion_1"><di:waypoint x="790" y="320" /><di:waypoint x="790" y="204" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Asociacion_2_di" bpmnElement="Asociacion_2"><di:waypoint x="600" y="410" /><di:waypoint x="500" y="480" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
